<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/letterbox">

    <LinearLayout
        android:id="@+id/browser_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/paper"
        android:fitsSystemWindows="true"
        android:orientation="vertical">

        <!-- Bilah alamat dan kawan-kawannya dibungkus satu wadah supaya bisa
             menyingkir bersama. Bilah status sistem tidak ikut disembunyikan. -->
        <LinearLayout
            android:id="@+id/chrome_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="@dimen/toolbar_height">

                <ImageButton
                    android:id="@+id/button_back"
                    style="@style/Widget.KalBrowser.IconButton"
                    android:contentDescription="@string/action_back"
                    android:src="@drawable/ic_back"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <ImageButton
                    android:id="@+id/button_forward"
                    style="@style/Widget.KalBrowser.IconButton"
                    android:contentDescription="@string/action_forward"
                    android:src="@drawable/ic_forward"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@id/button_back"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Ujung kanan tombol ini ditarik lebih dekat ke tetangganya,
                     supaya jarak ikon ke kotak alamat tinggal 8 dp. Padding
                     asimetris dipakai, bukan tombol yang dikecilkan, karena
                     sasaran sentuh tetap harus 44 dp. -->
                <ImageButton
                    android:id="@+id/button_reload"
                    style="@style/Widget.KalBrowser.IconButton"
                    android:contentDescription="@string/action_reload"
                    android:paddingStart="12dp"
                    android:paddingEnd="4dp"
                    android:src="@drawable/ic_reload"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@id/button_forward"
                    app:layout_constraintTop_toTopOf="parent" />

                <FrameLayout
                    android:id="@+id/address_field"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/field_height"
                    android:background="@drawable/bg_address_bar"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/button_sidebar"
                    app:layout_constraintStart_toEndOf="@id/button_reload"
                    app:layout_constraintTop_toTopOf="parent">

                    <EditText
                        android:id="@+id/address_bar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@null"
                        android:hint="@string/address_bar_hint"
                        android:imeOptions="actionGo"
                        android:importantForAutofill="no"
                        android:inputType="textUri"
                        android:maxLines="1"
                        android:paddingStart="@dimen/field_padding"
                        android:paddingEnd="40dp"
                        android:selectAllOnFocus="true"
                        android:textColor="@color/ink"
                        android:textColorHint="@color/ink_muted"
                        android:textSize="14sp" />

                    <!-- Panah kirim berada di dalam kotak, dan hanya muncul saat
                         dibutuhkan. Jarak kanan teks 40 dp menyisakan tempat
                         untuk panah ini supaya alamat panjang tidak tertutup. -->
                    <ImageButton
                        android:id="@+id/button_go"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_gravity="end|center_vertical"
                        android:layout_marginEnd="2dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/action_go"
                        android:padding="6dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_arrow_right"
                        android:tint="@color/ink"
                        android:visibility="gone" />

                </FrameLayout>

                <!-- Hamburger menempati ujung kanan bilah, tepat di tempat menu
                     titik tiga dulu berada. Jumlah tombol tidak bertambah, jadi
                     lebar kotak alamat tetap. -->
                <ImageButton
                    android:id="@+id/button_sidebar"
                    style="@style/Widget.KalBrowser.IconButton"
                    android:contentDescription="@string/action_sidebar"
                    android:src="@drawable/ic_menu"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/divider_width"
                android:background="@color/divider" />

            <!-- Progres tetap di chrome, bukan di dalam sidebar. Ia penanda
                 keadaan yang sedang berjalan, bukan pilihan. -->
            <ProgressBar
                android:id="@+id/page_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="@dimen/progress_height"
                android:indeterminate="false"
                android:progressTint="@color/signal"
                android:visibility="gone" />

        </LinearLayout>

        <FrameLayout
            android:id="@+id/viewport_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/letterbox">

            <WebView
                android:id="@+id/web_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <TextView
                android:id="@+id/empty_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:paddingStart="32dp"
                android:paddingEnd="32dp"
                android:text="@string/empty_hint"
                android:textColor="@color/letterbox_text"
                android:textSize="14sp" />

        </FrameLayout>

    </LinearLayout>

    <!-- Pita lipat. Ia menumpang di atas lapisan halaman, bukan bagian dari
         tata letak, supaya tinggi halaman tidak pernah berubah karena pita ini.
         Saat bilah alamat terbuka ia duduk tepat di bawah bilah, dan saat bilah
         terlipat ia berhenti di tepi atas layar dengan posisi ketuk yang sama. -->
    <FrameLayout
        android:id="@+id/fold_handle"
        android:layout_width="match_parent"
        android:layout_height="@dimen/fold_handle_height"
        android:layout_gravity="top"
        android:background="@color/paper"
        android:clickable="true"
        android:contentDescription="@string/action_fold_bar"
        android:focusable="true">

        <ImageView
            android:id="@+id/fold_arrow"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_fold_arrow"
            android:tint="@color/ink_muted" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_gravity="bottom"
            android:background="@color/divider" />

    </FrameLayout>

    <!-- Lapisan gelap saat sidebar terbuka. Mengetuknya menutup sidebar, dan ia
         menahan sentuhan supaya halaman di bawahnya tidak ikut bergerak. -->
    <View
        android:id="@+id/sidebar_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000"
        android:visibility="gone" />

    <!-- Sidebar ukuran masuk dari kanan, mengikuti sisi tombol yang membukanya.
         Isinya digambar kode dari satu daftar ukuran, jadi bentuk kartu, label,
         dan penanda pilihan aktif tidak mungkin berbeda dari yang dipakai
         halaman. -->
    <LinearLayout
        android:id="@+id/sidebar"
        android:layout_width="@dimen/sidebar_width"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@color/paper"
        android:elevation="8dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingTop="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp"
            android:text="@string/sidebar_sizes"
            android:textColor="@color/ink"
            android:textSize="14sp"
            android:textStyle="bold" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="4dp"
                android:paddingEnd="16dp"
                android:paddingBottom="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="@dimen/size_heading_gap"
                    android:paddingBottom="@dimen/size_label_gap"
                    android:text="@string/sidebar_landscape"
                    android:textColor="@color/ink_muted"
                    android:textSize="12sp" />

                <GridLayout
                    android:id="@+id/grid_landscape"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="4" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="@dimen/size_section_gap"
                    android:paddingBottom="@dimen/size_label_gap"
                    android:text="@string/sidebar_portrait"
                    android:textColor="@color/ink_muted"
                    android:textSize="12sp" />

                <GridLayout
                    android:id="@+id/grid_portrait"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="4" />

            </LinearLayout>

        </ScrollView>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/divider_width"
            android:background="@color/divider" />

        <!-- Tombol info halaman duduk di dasar sidebar, dengan bobot visual
             lebih ringan daripada kartu ukuran karena ia jarang dipakai. -->
        <LinearLayout
            android:id="@+id/sidebar_info"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_info"
                android:tint="@color/ink_muted" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="@string/sidebar_diagnostics"
                android:textColor="@color/ink"
                android:textSize="14sp" />

        </LinearLayout>

    </LinearLayout>

    <!-- Wadah video fullscreen diletakkan di lapisan paling atas supaya bisa
         menutupi toolbar dan sidebar, dan baru dipakai saat halaman memintanya. -->
    <FrameLayout
        android:id="@+id/fullscreen_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/letterbox"
        android:visibility="gone" />

</FrameLayout>
