<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Tombol ikon memakai latar ripple tanpa kotak, supaya chrome tidak
         menambah bidang warna yang bersaing dengan halaman web. -->
    <style name="Widget.DesktopBrowser.IconButton" parent="Widget.AppCompat.ActionButton">
        <item name="android:layout_width">@dimen/icon_button_size</item>
        <item name="android:layout_height">@dimen/icon_button_size</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:padding">8dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:tint">@color/icon_tint</item>
    </style>

    <!-- Tombol Buka memakai tinta biasa, bukan warna aksen: aksen disimpan
         untuk bilah progres dan keadaan fokus. -->
    <style name="Widget.DesktopBrowser.TextAction" parent="Widget.Material3.Button.TextButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">@dimen/toolbar_height</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textAllCaps">false</item>
    </style>

</resources>
